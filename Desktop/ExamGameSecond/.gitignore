*.csproj
*.sln
*.slnx
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# IDE / editor folders
.vs/
.vscode/
.idea/
*.suo

# OS files
.DS_Store
Thumbs.db

# Crash reports
sysinfo.txt
*.stackdump

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Addressables auto-generated
/Assets/AddressableAssetsData/*/*.bin*
/Assets/StreamingAssets/aa.meta
/Assets/StreamingAssets/aa/*
