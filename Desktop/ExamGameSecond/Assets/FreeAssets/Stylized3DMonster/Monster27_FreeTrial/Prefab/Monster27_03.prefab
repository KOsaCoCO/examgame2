  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4753e163761eecf4ab696fe53fd51b7b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NTGD124.Mobai
  _componentDescription: Drives one mob's behaviour based on its Difficulty Level
    (matches which list it was spawned from in MobSpawner) and the current day/night
    cycle read from the SkyTag-tagged object's rotation (found automatically at runtime).
    By day, mobs avoid stronger mobs and attack according to their difficulty rules,
    wandering idly on the NavMesh when nothing is nearby. By night, Easy and Medium
    mobs roll a chance to join a rally advancing on 'Center Orient', a placeholder
    found under the BaseSlot-tagged object. Reserves a hook for a future PlayerLevel
    system to force a rally on level-up and to gate whether Easy mobs consider the
    player attackable.
  DifficultyLevel: 2
  SkyTag: Sky
  NightStartDegrees: 180
  DayStartDegrees: 360
  PlayerTag: Player
  BaseSlotTag: BaseSlot
  CenterOrientName: Center Orient
  PlayerDetectionRange: 15
  ThreatDetectionRange: 15
  AttackRange: 4
  EasyFleePlayerDistance: 4
  EasyAttackCooldownSeconds: 1
  MediumAttackCooldownSeconds: 1
  HardAttackCooldownSeconds: 2
  NormalMoveSpeed: 3.5
  RallyMoveSpeed: 4.5
  RallyJoinChance: 0.3
  BehaviourCheckIntervalSeconds: 1
  IdleWanderRadius: 20
  DisableAutomaticBehaviour: 0
  MovementAnimationThreshold: 0.01
