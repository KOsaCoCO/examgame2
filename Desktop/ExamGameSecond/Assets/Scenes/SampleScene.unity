  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 771af42999f4b224e90ed8c0a4c4037b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NTGD124.BaseSlotWallSpawner
  _componentDescription: Instantiates WallKitPrefab once per slot in SlotExpander.Slots,
    positioned at that slot but deliberately NOT parented under the slot's own GameObject
    - BaseSlotExpander hides a locked slot's GameObject entirely (see RefreshSlotVisual),
    which would drag any child walls down with it and defeat the point of a wall
    standing there while the slot is still locked. Spawned kits parent under this
    component's own transform instead.
  SlotExpander: {fileID: 1640127195}
  WallKitPrefab: {fileID: 6187094871857169853, guid: c278a5ed5d5856f4b841935170c21efd, type: 3}
  ReferenceSlotGridCoord: {x: 0, y: -50}
