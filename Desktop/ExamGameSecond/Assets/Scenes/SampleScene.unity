  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::WizardNpcBehavior
  wizardObjectName: Wizard
  chaseSpeed: 9
  autoAdvanceSeconds: 3
  localRoamRadius: 6
  dialoguePanel: {fileID: 1531091284}
  dialogueText: {fileID: 1127058755}
  yesButton: {fileID: 1993273522}
  noButton: {fileID: 1173070733}
  greetingLine: At last - please, wait, I need your help!
  questOfferLine: A red miasma has overrun my home, and I can no longer clear it
    alone. Help me drive it out, and I will grant you some of my own magic in return.
  acceptedLine: Thank you. Return to me when you are ready, and we will begin.
  tradeHintLine: Before you go - come speak with me again anytime. Press E and I'll
    show you what I have to trade.
  insistLine: Please - I have nowhere else to turn. Will you help me?
  turnInLine: The red miasma is lifting - you've done it! Take my thanks; when you're
    ready, I have something special waiting for you at my trade stall.
