  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GirlNpcBehavior
  girlObjectName: Girl
  autoAdvanceSeconds: 3
  dialoguePanel: {fileID: 1531091284}
  dialogueText: {fileID: 1127058755}
  yesButton: {fileID: 1993273522}
  noButton: {fileID: 1173070733}
  greetingLine: Oh, hello! I'm glad I found this place.
  questOfferLine: Actually... my dog ran off and I can't find him anywhere. Could
    you help me look?
  acceptedLine: Really? Thank you so much, that means a lot!
  dogHintLine: I think he's on the island somewhere.
  insistLine: Please? I really can't find him on my own, I need your help.
  foundDogLine: You found him! Thank you, thank you so much!
  warningLine: Be careful at night, it's scary out there - monsters come around.
    Why don't you get some weapons?
