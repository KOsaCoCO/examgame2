  m_Script: {fileID: 11500000, guid: 05eb39bd7086eb940ba438e1f491299d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NTGD124.MobSpawner
  _componentDescription: 'Looks up the terrain by tag and calculates its true center
    point. Spawns mob clones at random positions inside distance rings from that
    center: no mobs near the middle (safe zone), easy mobs in the next ring, medium
    mobs further out, and hard mobs in the outermost ring, stopping short of the
    terrain edge where the fog colliders live.'
  TerrainTag: GameTerrain
  BaseSlotTag: BaseSlot
  CenterOrientName: Center Orient
  SafeZoneRadius: 60
  EasyZoneOuterRadius: 160
  MediumZoneOuterRadius: 200
  HardZoneOuterRadius: 400
  EasyMobPrefabs:
