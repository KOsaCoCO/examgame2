--- !u!114 &7030369238999368999
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 755706931610713443}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0374c5f279139d145a9aad48a2a26303, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NTGD124.BaseSlotWall
  _componentDescription: Hides this wall/corner segment once its own slot and every
    neighbor slot in Directions are all unlocked. Directions is set once on the wall-kit
    prefab per piece (wall1=South, wall2=West, wall3=North, wall4=East; a corner
    uses both of the directions in its name, e.g. cornerWalls1+2 = [South, West])
    - it does NOT change per spawn, since the same prefab piece always means the
    same compass side regardless of which slot it's spawned at. Initialize() (called
    by BaseSlotWallSpawner right after Instantiate) supplies the per-instance owner
    slot and BaseSlotExpander reference that Directions gets resolved against.
  Directions: 02000000
